# En Railway estas variables van en la pestaña "Variables" (no se sube ningún .env)
# Obligatorias
DISCORD_TOKEN=
CANAL_GENERAL=
DB_PATH=/app/data/radar.db

# Recomendada: ID de tu servidor (los comandos aparecen al instante)
GUILD_ID=

# Opcional: sin esto el bot funciona, pero no monitorea X
X_BEARER_TOKEN=

# Opcionales: canales separados por tipo de alerta (si no, todo va a CANAL_GENERAL)
CANAL_TOKENS_NUEVOS=
CANAL_TENDENCIAS=
CANAL_INFLUENCERS=
CANAL_NOTICIAS=

# Opcional: rol a mencionar cuando postea Elon o Trump
ROL_PING_ID=
